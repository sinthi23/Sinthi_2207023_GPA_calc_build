<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.calculator_builder.CalculatorController">

    <BorderPane>
        <top>
            <Label text="Add courses for GPA calculation" BorderPane.alignment="CENTER">
                <font>
                    <Font size="20.0" />
                </font>
                <padding>
                    <Insets bottom="10" top="10" />
                </padding>
            </Label>
        </top>

        <center>
            <VBox spacing="15" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">

                <!-- Form Section -->
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="120" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <Label text="Course name:" GridPane.rowIndex="0" />
                    <TextField fx:id="courseNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Course code:" GridPane.rowIndex="1" />
                    <TextField fx:id="courseCodeField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Credit:" GridPane.rowIndex="2" />
                    <TextField fx:id="creditField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Teacher 1:" GridPane.rowIndex="3" />
                    <TextField fx:id="teacher1Field" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="Teacher 2:" GridPane.rowIndex="4" />
                    <TextField fx:id="teacher2Field" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label text="Grade:" GridPane.rowIndex="5" />
                    <ComboBox fx:id="gradeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <padding>
                        <Insets bottom="10" left="20" right="20" top="10" />
                    </padding>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <!-- Table Section (Grows automatically) -->
                <TableView fx:id="courseTable" prefHeight="200.0" prefWidth="600.0" VBox.vgrow="NEVER">
                    <columns>
                        <TableColumn fx:id="courseNameColumn" text="Course Name" />
                        <TableColumn fx:id="courseCodeColumn" text="Code" />
                        <TableColumn fx:id="creditColumn" text="Credits" />
                        <TableColumn fx:id="teachersColumn" text="Instructors" />
                        <TableColumn fx:id="gradeColumn" text="Grade" />
                        <TableColumn fx:id="actionColumn" prefWidth="200.0" text="Actions" />
                    </columns>
                </TableView>

            </VBox>
        </center>

        <bottom>
            <VBox alignment="CENTER" spacing="10">
                <Button fx:id="addCourseButton" onAction="#handleAddCourse" prefWidth="150" style="-fx-background-color: #0033A0; -fx-text-fill: white" text="Add Course" />

                <Button fx:id="calculateButton" disable="true" onAction="#handleCalculateGPA" prefWidth="150" style="-fx-background-color: #3498db; -fx-text-fill: white" />

                <padding>
                    <Insets bottom="20" top="10" />
                </padding>
            </VBox>
        </bottom>

    </BorderPane>

</VBox>
